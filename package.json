{
  "name": "@local/browser",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Browser: per-session isolated Playwright browser for DSH with a live tab panel, sidebar section, per-site proxy and DevTools-grade tooling.",
  "license": "MIT",
  "author": "machine202502",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/machine202502/hsb-browser.git"
  },
  "homepage": "https://github.com/machine202502/hsb-browser#readme",
  "bugs": {
    "url": "https://github.com/machine202502/hsb-browser/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "install.mjs",
    "src/*.js",
    "src/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tests/*"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "lighthouse": "^13.5.0",
    "playwright-core": "1.64.1"
  },
  "scripts": {
    "test": "node tests/regression.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "bin": {
    "hsb-browser": "./install.mjs"
  }
}
